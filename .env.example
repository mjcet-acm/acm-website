# Database connection string (PostgreSQL for Local Docker & Coolify)
# Local: postgresql://postgres:postgres@127.0.0.1:5433/acm_website
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/acm_website

# Payload secret used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Server URL (http://localhost:3000 locally or your production domain e.g. https://acm.mjcet.ac.in)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Secret used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# Cloudflare R2 Object Storage (Optional: leave empty for local filesystem storage)
# R2_BUCKET=acm-website-media
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
# R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
